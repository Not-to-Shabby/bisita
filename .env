# Bisita Iligan Frontend
# Backend API URL
VITE_API_URL=http://localhost:5000/api

# Cloudinary (same as backend)
VITE_CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
VITE_CLOUDINARY_UPLOAD_PRESET=bisita_unsigned

# Map defaults
VITE_MAP_DEFAULT_LAT=8.228021
VITE_MAP_DEFAULT_LNG=124.245296
VITE_MAP_DEFAULT_ZOOM=13

# Features
VITE_ENABLE_OFFLINE=true
