# ===========================================
# Bisita Iligan Frontend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# -----------------------------
# API Configuration
# -----------------------------
# Backend API URL (Railway URL in production)
VITE_API_URL=http://localhost:5000/api

# -----------------------------
# Cloudinary (for direct uploads)
# -----------------------------
# Same cloud name as backend
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Upload preset for unsigned uploads (create in Cloudinary Settings > Upload)
# Or leave blank to use signed uploads via backend
VITE_CLOUDINARY_UPLOAD_PRESET=bisita_unsigned

# -----------------------------
# Maps Configuration
# -----------------------------
# Default map center (Iligan City)
VITE_MAP_DEFAULT_LAT=8.228021
VITE_MAP_DEFAULT_LNG=124.245296
VITE_MAP_DEFAULT_ZOOM=13

# -----------------------------
# Feature Flags (Optional)
# -----------------------------
# Enable/disable features for different environments
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_ANALYTICS=false
